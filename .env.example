# App settings
APP_NAME=InboxPilot
LOG_LEVEL=INFO

# LLM provider: use either OpenAI or Nebius
OPENAI_API_KEY=
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=openai/gpt-oss-120b

# LangSmith (optional)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=inboxpilot

# Gmail
GMAIL_EMAIL=
GMAIL_TOKEN_PATH=D:\Secrets\InboxPilot\token.json
GMAIL_SECRET_PATH=D:\Secrets\InboxPilot\client_secret.json
GOOGLE_CALENDAR_ID=primary

# Mem0
MEM0_API_KEY=
MEM0_HOST=https://api.mem0.ai
